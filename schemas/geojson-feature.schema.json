{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeoJSON Feature",
  "type": "object",
  "required": [
    "type",
    "geometry",
    "properties"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Feature"
      ]
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Point",
            "Polygon",
            "LineString"
          ]
        },
        "coordinates": {
          "type": "array"
        }
      }
    },
    "properties": {
      "type": "object"
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  }
}